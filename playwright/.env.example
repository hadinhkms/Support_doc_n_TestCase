# Sao chép file này thành .env và điền giá trị thật.
# .env đã nằm trong .gitignore - KHÔNG BAO GIỜ commit credential thật.

# --- Môi trường dưới test ---
BASE_URL=http://localhost:3000
# API base dùng cho seed/cleanup qua API (bỏ trống -> dùng BASE_URL)
API_BASE_URL=

# --- Tài khoản test ---
# Bắt buộc cho các test cần đăng nhập. Thiếu -> test fail nhanh (fail fast),
# không chạy âm thầm với dữ liệu rác.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Tài khoản quyền thấp, dùng cho test authorization / data isolation
TEST_VIEWER_EMAIL=
TEST_VIEWER_PASSWORD=

# --- Tuỳ chọn ---
# Token gọi API seed dữ liệu (nếu backend yêu cầu)
API_TOKEN=
# Bật chế độ chạy như CI ở local: CI=1
# CI=
